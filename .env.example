# ---- Sada ----
# Copy to .env and fill in. Nothing here is a real secret.

# --- app ---
ENVIRONMENT=development
DEBUG=false

# --- security (REQUIRED in production) ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# --- database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./data/sada.db
# Postgres (docker-compose sets this for you):
# DATABASE_URL=postgresql+psycopg://sada:sada@db:5432/sada

# --- storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=100

# --- transcription ---
# tiny | base | small | medium | large-v3
WHISPER_MODEL=tiny
# cpu | cuda
WHISPER_DEVICE=cpu
# int8 (cpu) | float16 (gpu) | float32
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Segments below this confidence get flagged. -0.75 is a sensible default.
LOW_CONFIDENCE_THRESHOLD=-0.75

# --- limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRANSCRIBE=10/minute
RATE_LIMIT_DEFAULT=120/minute
# Comma-separated. Set to your real origin in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- postgres (docker-compose only) ---
POSTGRES_USER=sada
POSTGRES_PASSWORD=sada
POSTGRES_DB=sada
